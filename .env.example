# Copy to .env (git-ignored, never commit it).

# Platform's own Discord application, used only for "Log in with Discord".
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=

# Encrypts creators' bot tokens in the database (64 hex digits).
# PLATFORM_MASTER_KEY=

# GitHub App (deploy from a creator's repository). All five, or none.
# GITHUB_APP_ID=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_SLUG=
# GITHUB_APP_PRIVATE_KEY_FILE=
# GITHUB_WEBHOOK_SECRET=

# Discord user ID with access to /admin.
# PLATFORM_ADMIN_USER_ID=

# Stripe, test mode only (sk_live_/rk_live_ keys are refused).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# PLATFORM_STRIPE_CURRENCY=usd

# PLATFORM_PUBLIC_URL=http://127.0.0.1:8080
# PLATFORM_BOT_IMAGE=platform-discord-bot:dev

# Anti-abuse limits (defaults shown)
# PLATFORM_MAX_PRODUCTS=2
# PLATFORM_DEPLOY_COOLDOWN_SECS=10
# PLATFORM_MAX_IMAGE_MB=10
# PLATFORM_POLL_SECS=30
# PLATFORM_BUILD_TIMEOUT_SECS=600
